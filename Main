import cv2
import numpy as np
import mediapipe as mp

mp_hands = mp.solutions.hands
hands = mp_hands.Hands(max_num_hands=2, min_detection_confidence=0.5, min_tracking_confidence=0.5)

cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

if not cap.isOpened():
    raise RuntimeError("Couldn't open webcam.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(rgb)

    if results.multi_hand_landmarks and len(results.multi_hand_landmarks) == 2:
        h, w, _ = frame.shape

        h1 = results.multi_hand_landmarks[0]
        h2 = results.multi_hand_landmarks[1]

        t1 = (int(h1.landmark[4].x * w), int(h1.landmark[4].y * h))
        f1 = (int(h1.landmark[8].x * w), int(h1.landmark[8].y * h))

        t2 = (int(h2.landmark[4].x * w), int(h2.landmark[4].y * h))
        f2 = (int(h2.landmark[8].x * w), int(h2.landmark[8].y * h))

        cv2.circle(frame, t1, 6, (255, 0, 0), -1)
        cv2.circle(frame, f1, 6, (0, 0, 255), -1)
        cv2.circle(frame, t2, 6, (255, 0, 0), -1)
        cv2.circle(frame, f2, 6, (0, 0, 255), -1)

        pts = np.array([f1, f2, t2, t1], np.int32)

        mask = np.zeros(frame.shape[:2], np.uint8)
        cv2.fillPoly(mask, [pts], 255)

        inv = cv2.bitwise_not(frame)
        frame[mask == 255] = inv[mask == 255]

        cv2.polylines(frame, [pts], True, (0, 255, 0), 3)

    cv2.imshow("Quadrilateral", frame)

    if cv2.waitKey(1) & 0xFF == 27:
        break

cap.release()
cv2.destroyAllWindows()
